# ESP32-C3 (G02) Project default config
# Note: Keep essential configs when sdkconfig is regenerated.
#       Matching boardHEALTH_MONITOR_EN in main/board_config.h.
# ---------------------------------------------------------------

# HealthTask dependencies:
#   USE_IDLE_HOOK        -> vApplicationIdleHook
#   GENERATE_RUN_TIME_STATS -> uxTaskGetSystemState/vTaskList/vTaskGetRunTimeStats
CONFIG_FREERTOS_USE_IDLE_HOOK=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

# Display task frame timing:
#   100Hz -> 10ms tick quantization; 1000Hz -> 1ms precision for 30FPS / 33ms
CONFIG_FREERTOS_HZ=1000

# LVGL builtin malloc pool (80KB pool for 140x52 RGB565 GIF + UI objects, leaves ~100KB for WiFi & system heap):
CONFIG_LV_MEM_SIZE_KILOBYTES=80
CONFIG_LV_DRAW_THREAD_STACK_SIZE=2048

# LVGL native GIF decoder support
CONFIG_LV_USE_GIF=y

# Flash real size 8MB (partitions: factory=6M + storage@0x610000;
# with 2MB flash size the storage partition would fall out of range and be unusable)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"

# Use project custom partition table (contains storage partition;
# required by Flash/app_info parameter storage)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# WiFi RAM optimization for ESP32-C3 (Preserve heap for LVGL and FreeRTOS tasks):
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n

