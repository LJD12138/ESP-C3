{
  "configurations": [
    {
      "name": "ESP-IDF",
      "compilerPath": "",
      "compileCommands": "${config:idf.buildPath}/compile_commands.json",
      "includePath": [
        "${config:idf.espIdfPath}/components/**",
        "${config:idf.espIdfPathWin}/components/**",
        "${workspaceFolder}/**",
        "${workspaceFolder}/main",
        "${workspaceFolder}/managed_components/lvgl__lvgl",
        "${workspaceFolder}/managed_components/lvgl__lvgl/examples/porting"
      ],
      "browse": {
        "path": [
          "${config:idf.espIdfPath}/components",
          "${config:idf.espIdfPathWin}/components",
          "${workspaceFolder}"
        ],
        "limitSymbolsToIncludedHeaders": true
      }
    }
  ],
  "version": 4
}