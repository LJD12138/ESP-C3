CompileFlags:
  # 使用 ESP-IDF 生成的编译数据库 (clangd 默认只在源码目录及上级查找, 不会进入 build/)
  CompilationDatabase: build
  Add:
    # 补充 RISC-V GCC (ESP32-C3) 工具链标准库与编译器头文件 (解决 sys/reent.h not found)
    - -isystem
    - C:/Espressif/tools/riscv32-esp-elf/esp-14.2.0_20251107/riscv32-esp-elf/riscv32-esp-elf/include
    - -isystem
    - C:/Espressif/tools/riscv32-esp-elf/esp-14.2.0_20251107/riscv32-esp-elf/lib/gcc/riscv32-esp-elf/14.2.0/include
    - -isystem
    - C:/Espressif/tools/riscv32-esp-elf/esp-14.2.0_20251107/riscv32-esp-elf/lib/gcc/riscv32-esp-elf/14.2.0/include-fixed
  Remove:
    # 移除 GCC 专有、Clang 无法识别的编译参数，消除 Unknown argument 错误
    - -mlongcalls
    - -fno-shrink-wrap
    - -fstrict-volatile-bitfields
    - -fno-tree-switch-conversion
    - -fno-jump-tables
